# =============================================================================
# AI Memory — example environment variables
# =============================================================================
# Copy to `.env` and fill in your own values. NEVER commit a real `.env`
# (it is gitignored). Use placeholders only in this file.
# =============================================================================

# Databricks workspace
DATABRICKS_HOST     = https://<your-workspace>.cloud.databricks.com
# Local dev token:  databricks auth token --profile <profile>

# Lakebase Postgres connection (PGHOST/PGPORT/PGUSER are auto-injected on
# Databricks Apps by the Postgres resource binding; set them locally for dev).
PGHOST              = <your-lakebase-host>.database.cloud.databricks.com
PGPORT              = 5432
PGUSER              = <your-app-or-user-id>
PGDATABASE          = databricks_postgres
PGSSLMODE           = require
LAKEBASE_SCHEMA     = aimem
# Lakebase database instance name (used to mint OAuth credentials).
LAKEBASE_INSTANCE   = <your-lakebase-instance-name>

# Databricks Foundation Model embedding endpoint + output dimensionality.
EMBEDDING_ENDPOINT  = databricks-bge-large-en
EMBEDDING_DIM       = 1024

# Chainlit auth cookie signing secret (generate with: chainlit create-secret)
CHAINLIT_AUTH_SECRET = <your-chainlit-auth-secret>

# Local development environment variables.
# Copy to .env and fill in the values for YOUR workspace.
#
# Every <placeholder> below is required -- the app logs a startup error naming
# the variable if one is missing. Deployed runs get these from databricks.yml
# instead; this file is only for `python scripts/start_app.py` locally.

# ── Databricks auth ──
# Local runs use your CLI profile by default (DATABRICKS_CONFIG_PROFILE).
# Uncomment to override with an explicit host + token instead.
# DATABRICKS_CONFIG_PROFILE=<your-cli-profile>
# DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
# DATABRICKS_TOKEN=<your-pat>

# ── Lakebase Autoscaling ──
LAKEBASE_PROJECT=lakebase-genie-caching
# Optional; defaults to projects/<LAKEBASE_PROJECT>/branches/production/endpoints/primary
# ENDPOINT_NAME=projects/lakebase-genie-caching/branches/production/endpoints/primary

# ── Databricks resources ──
# Warehouse ID: from the warehouse's "Connection details" tab, or
#   databricks warehouses list --profile <your-profile>
SQL_WAREHOUSE_ID=<your-warehouse-id>
# Genie space ID: the 32-hex segment of the space URL, /genie/rooms/<space_id>.
# Comma-separate for multi-space routing.
GENIE_SPACE_IDS=<your-genie-space-id>

# ── MLflow ──
MLFLOW_TRACKING_URI=databricks
MLFLOW_EXPERIMENT_NAME=/lakebase-genie-caching
# UC location for the trace archive table the batch pipeline reads.
TRACE_ARCHIVE_CATALOG=<your-catalog>
TRACE_ARCHIVE_SCHEMA=<your-schema>
TRACE_ARCHIVE_TABLE=mlflow_traces_archived

# ── Optional tuning ──
# Refuse to run Genie or cached SQL as the app's service principal: a caller token
# must be present, so Unity Catalog enforces per-user access. Requires user
# authorization on the app. Turn ON before using data with per-user access rules.
# REQUIRE_USER_AUTH=false

# Delete conversation sessions untouched for this many days.
# SESSION_MAX_AGE_DAYS=90

# Per-call timeouts, in seconds.
# TIMEOUT_CLASSIFIER_LLM=15
# TIMEOUT_ASSISTANT_LLM=60
# TIMEOUT_SUPERVISOR_LLM=45
# TIMEOUT_CACHED_SQL=30

# ── Logging ──
LOG_LEVEL=INFO

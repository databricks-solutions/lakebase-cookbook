# =============================================================================
# __TITLE__ — example environment variables
# =============================================================================
# Copy to `.env` and fill in your own values. NEVER commit a real `.env`
# (it is gitignored). Use placeholders only in this file.
# =============================================================================

# Databricks workspace
DATABRICKS_HOST     = https://<your-workspace>.cloud.databricks.com
# Prefer OAuth / SP over a PAT for anything long-lived.
# Local dev token:  databricks auth token --profile <profile>

# Lakebase
LAKEBASE_DATABASE   = projects/<project>/branches/<branch>/databases/<id>
LAKEBASE_CATALOG    = default
LAKEBASE_SCHEMA     = public

# Add other example-specific settings below with placeholder values.

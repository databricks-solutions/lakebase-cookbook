# Databricks Asset Bundle for the "__TITLE__" Lakebase Cookbook example.
#
# Deploy:  databricks bundle deploy -t demo
# Run:     databricks bundle run <resource_name> -t demo
#
# Override any workspace-specific value at deploy time, e.g. the Lakebase DB path:
#   databricks bundle deploy -t demo \
#     --var lakebase_database="projects/<project>/branches/<branch>/databases/<id>"

bundle:
  name: __BUNDLE_NAME__

include:
  - resources/*.yml

# All workspace-specific values are variables — never hardcode them in code.
# Keep sizing small/cheap (scale-to-zero, smallest warehouse) per CONTRIBUTING.md.
variables:
  app_name:
    default: __NAME__-demo
  # Lakebase — retrieve the full database path from Catalog Explorer → Lakebase,
  # or the Lakebase APIs, after the project/branch/database exist.
  lakebase_branch:
    description: Lakebase project/branch path, e.g. projects/<project>/branches/<branch>
    default: projects/CHANGE_ME/branches/production
  lakebase_database:
    description: Full Lakebase database resource path (required for the Postgres binding).
    default: projects/CHANGE_ME/branches/production/databases/CHANGE_ME
  lakebase_catalog:
    default: default
  lakebase_schema:
    default: public
  # Add any other example-specific variables here (genie_space_id, warehouse_id, …).

sync:
  paths:
    - ./

targets:
  demo:
    default: true
    mode: production
    workspace:
      root_path: /Workspace/Users/${workspace.current_user.userName}/.bundle/${bundle.name}/${bundle.target}
    variables:
      app_name: __NAME__-demo
      lakebase_branch: projects/CHANGE_ME/branches/production
      lakebase_database: projects/CHANGE_ME/branches/production/databases/CHANGE_ME
      lakebase_catalog: default
      lakebase_schema: public

---
interface Props {
  type?: 'info' | 'note' | 'warning' | 'tip';
  title?: string;
}
const { type = 'info', title } = Astro.props;

const styles: Record<string, { border: string; label: string }> = {
  info: { border: 'var(--color-lava-600)', label: 'var(--color-lava-600)' },
  note: { border: 'var(--color-ink)', label: 'var(--color-ink)' },
  tip: { border: '#1a9e6c', label: '#1a9e6c' },
  warning: { border: '#d98a00', label: '#b06f00' },
};
const s = styles[type] ?? styles.info;
---

<aside
  class="my-6 border-l-4 bg-[var(--color-band)] px-5 py-4"
  style={`border-color:${s.border}`}
>
  {
    title && (
      <div
        class="mono-label mb-1 text-[0.7rem]"
        style={`color:${s.label}`}
      >
        {title}
      </div>
    )
  }
  <div class="text-sm leading-relaxed text-[var(--color-ink)] [&>p:last-child]:mb-0 [&>p]:mb-2">
    <slot />
  </div>
</aside>

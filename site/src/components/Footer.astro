---
import { FOOTER, SITE } from '../config';
const year = new Date().getFullYear();
const external = (href: string) => href.startsWith('http');
---

<footer class="mt-24 border-t border-[var(--color-line)] bg-[var(--color-band)]">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
      <div class="col-span-2 sm:col-span-1">
        <div class="flex items-center gap-2.5">
          <img src="/img/lakebase-icon.png" alt="" width="22" height="22" />
          <span class="mono-label text-[var(--color-ink)]">{SITE.title}</span>
        </div>
        <p class="mt-3 max-w-xs text-sm leading-relaxed text-[var(--color-muted)]">
          {SITE.tagline}
        </p>
      </div>

      {
        FOOTER.columns.map((col) => (
          <div>
            <div class="mono-label mb-3 text-[0.7rem] text-[var(--color-muted)]">
              {col.title}
            </div>
            <ul class="flex flex-col gap-2">
              {col.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    {...external(link.href)
                      ? { target: '_blank', rel: 'noopener noreferrer' }
                      : {}}
                    class="text-sm text-[var(--color-ink)] hover:text-[var(--color-lava-600)]"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div
      class="mono-label mt-10 border-t border-[var(--color-line)] pt-6 text-[0.7rem] text-[var(--color-muted)]"
    >
      © {year} Databricks, Inc.
    </div>
  </div>
</footer>

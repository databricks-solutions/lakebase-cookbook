---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry: CollectionEntry<'blog'>) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <article class="mx-auto max-w-3xl">
    <a
      href="/blog/"
      class="mono-label text-[0.7rem] text-[var(--color-muted)] hover:text-[var(--color-lava-600)]"
      >← All posts</a
    >
    <div class="mono-label mt-6 text-[0.7rem] text-[var(--color-lava-600)]">
      {fmt(entry.data.date)}
    </div>
    <div class="prose-doc mt-2">
      <h1>{entry.data.title}</h1>
      <Content />
    </div>
  </article>
</BaseLayout>

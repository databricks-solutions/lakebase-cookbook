---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, type CollectionEntry } from 'astro:content';

const posts = (await getCollection('blog', ({ data }: CollectionEntry<'blog'>) =>
  import.meta.env.PROD !== true ? true : !data.draft,
)).sort(
  (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) =>
    b.data.date.getTime() - a.data.date.getTime(),
);

const fmt = (d: Date) =>
  d.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---

<BaseLayout title="Blog" description="Updates and articles from the Lakebase Cookbook.">
  <span class="tag-chip">Blog</span>
  <h1 class="mt-5 text-4xl font-light tracking-tight sm:text-5xl">Blog</h1>
  <p class="mt-4 mb-12 max-w-3xl text-[var(--color-muted)]">
    Updates, patterns, and notes from the Lakebase Cookbook.
  </p>

  <div class="flex flex-col">
    {
      posts.map((post: CollectionEntry<'blog'>) => (
        <a
          href={`/blog/${post.id}/`}
          class="group grid grid-cols-1 gap-2 border-t border-[var(--color-line)] py-8 transition-colors last:border-b hover:bg-[var(--color-band)] sm:grid-cols-[140px_1fr] sm:gap-8"
        >
          <div class="mono-label text-[0.7rem] text-[var(--color-muted)] sm:pt-1">
            {fmt(post.data.date)}
          </div>
          <div>
            <h2 class="text-2xl font-light tracking-tight text-[var(--color-ink)] group-hover:text-[var(--color-lava-600)]">
              {post.data.title}
            </h2>
            {post.data.description && (
              <p class="mt-2 max-w-2xl text-[var(--color-muted)]">
                {post.data.description}
              </p>
            )}
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { RESOURCES } from '../data/resources';
---

<BaseLayout
  title="Resources"
  description="A collection of resources for building on Databricks Lakebase."
>
  <span class="tag-chip">Resources</span>
  <h1 class="mt-5 text-4xl font-light tracking-tight sm:text-5xl">
    Lakebase resources
  </h1>
  <p class="mt-4 mb-12 max-w-3xl text-[var(--color-muted)]">
    A collection of resources for building on Databricks Lakebase. Submit a
    resource by{' '}
    <a
      href="https://github.com/databricks-solutions/lakebase-cookbook/pulls"
      target="_blank"
      rel="noopener noreferrer"
      class="link-underline">raising a PR</a
    >.
  </p>

  <div class="grid grid-cols-1 gap-px border border-[var(--color-line)] bg-[var(--color-line)] md:grid-cols-2">
    {
      RESOURCES.map((r) => (
        <a
          href={r.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col bg-[var(--color-canvas)] p-6 transition-colors hover:bg-[var(--color-band)]"
        >
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="mono-label border border-[var(--color-lava-600)] px-2 py-1 text-[0.65rem] text-[var(--color-lava-600)]">
              {r.type}
            </span>
            <span class="mono-label border border-[var(--color-ink)] px-2 py-1 text-[0.65rem] text-[var(--color-ink)]">
              {r.category}
            </span>
          </div>
          <h2 class="text-xl font-normal leading-snug text-[var(--color-ink)] group-hover:text-[var(--color-lava-600)]">
            {r.title}
          </h2>
          <p class="mt-3 flex-1 text-sm leading-relaxed text-[var(--color-muted)]">
            {r.summary}
          </p>
        </a>
      ))
    }
  </div>
</BaseLayout>

# =============================================================================
# Branching CI/CD — environment variables
# =============================================================================
# These mirror the GitHub Actions secrets the workflows read. For a local
# dry-run (.github/scripts/run_local.sh), copy to `.env` and fill in your own
# values, or export them in your shell. NEVER commit a real `.env` — it is
# gitignored. Placeholders only in this file.
# =============================================================================

# Databricks workspace
DATABRICKS_HOST     = https://<your-workspace>.cloud.databricks.com
# Local dev token:  databricks auth token --profile <profile>
# In CI this is the DATABRICKS_TOKEN secret (PAT or SP OAuth token).
DATABRICKS_TOKEN    = <your-token>

# Lakebase project the CI/CD acts on (provision it first — see README)
LAKEBASE_PROJECT        = <your-lakebase-project-id>
LAKEBASE_SOURCE_BRANCH  = production
LAKEBASE_DATABASE       = databricks_postgres
LAKEBASE_PG_USER        = <your-databricks-user-email>

# AI Gateway serving endpoint used for the per-PR impact review
AI_GATEWAY_MODEL    = databricks-claude-opus-4-7

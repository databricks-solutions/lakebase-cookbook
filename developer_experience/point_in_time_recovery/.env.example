# =============================================================================
# Point-in-time recovery — environment variables
# =============================================================================
# Copy to `.env` and fill in your own values, or export them in your shell.
# NEVER commit a real `.env` — it is gitignored. Placeholders only in this file.
#
# Authentication uses the standard Databricks SDK resolution. Either set
# DATABRICKS_HOST + DATABRICKS_TOKEN below, or run against a configured profile
# with `--profile <name>` / DATABRICKS_CONFIG_PROFILE and leave these unset.
# =============================================================================

# Databricks workspace (omit if you authenticate via a ~/.databrickscfg profile)
DATABRICKS_HOST     = https://<your-workspace>.cloud.databricks.com
# Local dev token:  databricks auth token --profile <profile>
DATABRICKS_TOKEN    = <your-token>

# Lakebase project and the branch to recover from
LAKEBASE_PROJECT        = <your-lakebase-project-id>
LAKEBASE_SOURCE_BRANCH  = production
LAKEBASE_ENDPOINT       = primary
LAKEBASE_DATABASE       = databricks_postgres
LAKEBASE_PG_SCHEMA      = public

# App to repoint at the recovery branch (leave unset to only create the branch)
DATABRICKS_APP_NAME     = <your-app-name>
